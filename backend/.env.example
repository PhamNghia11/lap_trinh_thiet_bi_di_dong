PORT=3000
DATABASE_URL="postgresql://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="15m"
TMDB_API_KEY=""
TMDB_BASE_URL="https://api.themoviedb.org/3"
WEB_ORIGIN="http://localhost:8080"
PUBLIC_API_URL="http://localhost:3000"
OAUTH_RETURN_URL="http://localhost:8765/#/auth/callback"
ENABLE_SWAGGER="false"
# Supabase Storage dùng URL project, không dùng URL database pooler.
# Lấy service_role key tại Supabase Dashboard > Project Settings > API Keys.
# Chỉ lưu service_role key ở backend và Render; tuyệt đối không đưa vào Flutter Web.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Bucket này phải được tạo public trong Supabase Storage trước khi deploy.
SUPABASE_STORAGE_BUCKET="flix-media"

# Thông tin OAuth Web application từ Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Thông tin Facebook Login từ Meta for Developers.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_GRAPH_VERSION=""

# Gửi email đặt lại mật khẩu qua Brevo Transactional Email API.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="no-reply@example.com"
BREVO_SENDER_NAME="FLIX"
